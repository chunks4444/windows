RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

ErrorDocument 404 /404.php

# 어드민이 차단한 IP는 모든 PHP 요청보다 먼저 여기서 403 처리 (src/admin/stats.php "비로그인 방문" 탭에서 관리)
# 운영 도메인일 때만 적용 — 절대경로가 운영 서버 기준이라 로컬 XAMPP Apache에서 그대로 걸리면
# 파일을 못 찾아 전체 페이지가 깨짐(Host 조건 없이 걸었다가 로컬에서 에러난 적 있음)
<If "%{HTTP_HOST} == 'studio.pyeongmok.com' || %{HTTP_HOST} == 'pyeongmok.com' || %{HTTP_HOST} == 'www.pyeongmok.com'">
    php_value auto_prepend_file "/home/chunks/web/studio.pyeongmok.com/src/lib/ip_block.php"
</If>

# 예전 워드프레스 시절 서비스워커가 남아있는 브라우저를 위한 킬스위치 (wp.serviceworker 참고)
AddType application/javascript .serviceworker

# studio.pyeongmok.com은 정식 서비스 도메인(pyeongmok.com)과 같은 코드를 쓰지만 검색엔진에는
# 노출되면 안 됨 — 사이트는 그대로 작동하되 이 호스트일 때만 색인을 막는다.
<IfModule mod_headers.c>
    SetEnvIf Host "^studio\.pyeongmok\.com$" IS_STUDIO_HOST
    Header set X-Robots-Tag "noindex, nofollow" env=IS_STUDIO_HOST
</IfModule>

# /src/work/ → /src/portfolio/ 리다이렉트
RewriteRule ^src/work/detail\.php$ /src/portfolio/detail.php [R=301,L,QSA]
RewriteRule ^src/work/?$ /src/portfolio/ [R=301,L]
SetEnv PMOK_JWT_SECRET "새로운-강력한-시크릿"

# ============================================================
# 깔끔한 URL: /src/{blog,portfolio,collection,guide,company,mypage}와 .php 확장자를 주소창에서 숨김.
# admin/api/engine/css/js/lib/components/assets/img/uploads는 대상 아님 — 내부 전용·자산 경로라 그대로 /src/... 유지.
# 2026-07-08 추가. 각 섹션 링크를 생성하는 PHP/JS도 함께 새 주소로 바꿔야 실제로 /src/가 안 보임(nav.php 등).
# ============================================================

# 사용자가 /src/{6개 섹션}/... 로 직접 들어오면 새 주소로 301 (검색엔진 중복 색인 방지, 옛 링크 호환)
# .php로 끝나는 옛 링크는 확장자까지 같이 제거해야 아래 페이지 규칙과 매칭됨(먼저 매칭되도록 위에 배치)
RewriteCond %{THE_REQUEST} \s/src/(blog|portfolio|collection|guide|company|mypage)(/[^\s?]*)?\.php(\?[^\s]*)?\s [NC]
RewriteRule ^src/(blog|portfolio|collection|guide|company|mypage)(.*)\.php$ /$1$2 [R=301,L,QSA]

# src/guide/guide.css처럼 페이지 폴더 안에 섞여 있는 정적 자산은 리다이렉트 대상에서 제외
# (그대로 /src/... 경로로 서빙되어야 함 — 아니면 아래 페이지 규칙이 .확장자 있는 파일명을 안 받아줘서 404남)
RewriteCond %{THE_REQUEST} \s/src/(blog|portfolio|collection|guide|company|mypage)([/?][^\s]*)?\s [NC]
RewriteCond %{THE_REQUEST} !\.(css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf)(\?[^\s]*)?\s [NC]
RewriteRule ^src/(blog|portfolio|collection|guide|company|mypage)(.*)$ /$1$2 [R=301,L,QSA]

# 섹션 홈: 슬래시 없는 형태(/blog)는 슬래시 있는 정규 주소(/blog/)로 301
# — 두 형태가 각각 서빙되면 canonical이 요청 URL을 따라가면서 갈라짐(중복 색인 원인)
RewriteRule ^(blog|portfolio|collection|guide|company)$ /$1/ [R=301,L]

# 섹션 홈(디렉토리 인덱스)
RewriteRule ^blog/?$        src/blog/index.php       [L]
RewriteRule ^portfolio/?$   src/portfolio/index.php  [L]
RewriteRule ^collection/?$  src/collection/index.php [L]
RewriteRule ^guide/?$       src/guide/index.php      [L]
RewriteRule ^company/?$     src/company/index.php    [L]
RewriteRule ^privacy/?$     src/legal/privacy.php    [L]
RewriteRule ^terms/?$       src/legal/terms.php      [L]

# 블로그/포트폴리오 글 상세 시맨틱 URL: /blog/{slug}, /portfolio/{slug} → detail.php?slug={slug}
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([^/]+)/?$ src/blog/detail.php?slug=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^portfolio/([^/]+)/?$ src/portfolio/detail.php?slug=$1 [L,QSA]

# 나머지 확장자 없는 페이지: /collection/detail, /guide/{name}, /mypage/{name} (밑줄로 시작하는 내부 include 파일은 제외)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^collection/([a-zA-Z][a-zA-Z0-9_-]*)/?$ src/collection/$1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^guide/([a-zA-Z][a-zA-Z0-9_-]*)/?$ src/guide/$1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^mypage/([a-zA-Z][a-zA-Z0-9_-]*)/?$ src/mypage/$1.php [L,QSA]

# 동적 sitemap.xml
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# 블로그 RSS 피드
RewriteRule ^rss\.xml$ /rss.php [L]

# 도면 썸네일 확장자 없는 주소 지원: /uploads/drawing_thumbs/{name} → {name}.png
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/drawing_thumbs/([A-Za-z0-9_]+)$ uploads/drawing_thumbs/$1.png [L]